#!/usr/bin/env python3
"""
snn_slam_twin.py — Digital Twin for Neuromorphic SLAM

2D CANN (x, y) + 1D Ring Attractor (θ) with ANALYTICAL Mexican Hat initialization.
No training needed for attractor dynamics — initialized from Neural Field equations.

Architecture:
  Events → ON/OFF → W_vis → LIF_visual → hidden features
                                           ↓
  [vx, vy, ω] ─────────────────────────────→ velocity_injection
                                                          ↓
  2D CANN sheet (DoG weights) ←→ recurrent (x,y) bump
       ↓ sensory_correction (I_obs from ToF landmarks)
  1D Ring Attractor (DoG weights) ←→ recurrent θ bump
       ↓ sensory_correction (I_obs from bearing)
                                                          ↓
                                      LI_readout → [x̂, ŷ, θ̂, obs_x, obs_y]

Author: Ada 🦊
Mathematical framework: Mexican Hat / Difference of Gaussians (DoG)
"""

import jax
import jax.numpy as jnp
from jax import random
import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from matplotlib.patches import Rectangle, Circle
import time

import sys
sys.path.insert(0, '/Users/lhooz/.openclaw/workspace')

from src.sparse_forest import (
    generate_fixed_room_dataset,
    N_PIXELS, TIME_STEPS, DT,
    ROOM_W, ROOM_H, FOV_DEG,
    VX_RANGE, VY_RANGE, OMEGA_RANGE,
)

# ============================================================================
# Configuration
# ============================================================================
SEED = 42
BATCH_SIZE = 32
N_SHOW = 4

# CANN (2D spatial sheet)
CANN_SIZE = 32          # 32×32 = 1024 neurons
A_EXC = 0.5             # USER: area_exc = 0.5×1² = 0.5
A_INH = 0.125           # USER: area_inh = 0.125×2² = 0.5 (BANG-BANG balanced!)
                        # Self-connection = A_exc - A_inh = 0.375
                        # Area ratio = 1.0 ✅ (blue line drops to near zero)
SIGMA_EXC = 1.0         # excitatory radius (cells)
SIGMA_INH = 2.0         # inhibitory radius (cells)
TAU_U = 0.05            # membrane time constant (seconds)

# Ring Attractor (1D heading)
RING_N = 64             # 64 neurons for 360°
RING_A_EXC = 1.0        # excitatory amplitude
RING_A_INH = 0.50       # stronger inhibition to prevent exponential growth (was 0.40)
                        # Integer index: d=0→+0.50, d=4→-0.21, d=5→-0.25 (proper Mexican Hat!)
                        # Self-connection = 0.50 (reduced from 0.60 to dampen instability)
RING_SIGMA_EXC = 2.0    # excitatory spread (in neuron units)
RING_SIGMA_INH = 4.0    # inhibitory spread (in neuron units)
RING_TAU_U = 0.03

# Spiking LIF
BETA_LIF = 0.85
V_TH = 1.0

# Gains
# Physics: room=10m, grid=32 cells → 10/32=0.3125 m/cell
# VEL_GAIN_XY = dt / meters_per_cell = 0.02 / 0.3125 = 0.064
# With corrected einsum 'ij,bj->bi', ratio was 1.35, so tune
VEL_GAIN_XY = 0.05       # velocity → bump shift (best setting)
VEL_GAIN_TH = 0.15       # omega → ring (strong enough to break grid-pinning)
SENS_GAIN_XY = 0.05      # landmark correction
SENS_GAIN_TH = 0.02       # bearing correction

# Network dims
N_VIS = N_PIXELS * 2
HIDDEN = 128
N_OUT = 5


# ============================================================================
# 1. Mexican Hat / DoG Weight Matrix Construction
# ============================================================================

def build_2d_cann_weights(cann_size=CANN_SIZE, a_exc=A_EXC, a_inh=A_INH,
                           sigma_exc=SIGMA_EXC, sigma_inh=SIGMA_INH):
    """Build 2D CANN recurrent weight matrix: W_ij = A_exc·G_exc(d_ij) - A_inh·G_inh(d_ij)

    Uses toroidal (wrap-around) distance for continuous attractor on torus.
    Returns: (cann_size², cann_size²) matrix
    """
    N = cann_size * cann_size
    coords_x, coords_y = jnp.meshgrid(
        jnp.arange(cann_size, dtype=jnp.float32),
        jnp.arange(cann_size, dtype=jnp.float32),
        indexing='xy'
    )

    rows = []
    for ry in range(cann_size):
        for rx in range(cann_size):
            # Toroidal distance from (rx, ry) to all neurons
            dx = jnp.abs(coords_x - rx)
            dx = jnp.minimum(dx, cann_size - dx)  # wrap
            dy = jnp.abs(coords_y - ry)
            dy = jnp.minimum(dy, cann_size - dy)  # wrap
            d2 = dx**2 + dy**2
            d = jnp.sqrt(d2.astype(jnp.float32))
            # DoG: +excitatory center, -inhibitory surround
            w = (a_exc * jnp.exp(-d**2 / (2 * sigma_exc**2))
                 - a_inh * jnp.exp(-d**2 / (2 * sigma_inh**2)))
            rows.append(w.ravel())
    W = jnp.stack(rows)  # (N, N)

    # Normalize by self-connection (center diagonal = 1.0).
    # This ensures the bump can sustain itself through recurrent excitation.
    # center_idx = (cann_size//2) * cann_size + (cann_size//2)
    center_idx = (cann_size // 2) * cann_size + (cann_size // 2)
    self_conn = W[center_idx, center_idx]
    W = W / (self_conn + 1e-8)
    W = W * 0.5

    return W


def build_1d_ring_weights(ring_n=RING_N, a_exc=RING_A_EXC, a_inh=RING_A_INH,
                          sigma_exc=RING_SIGMA_EXC, sigma_inh=RING_SIGMA_INH):
    """Build 1D ring attractor weight matrix using INTEGER INDEX distance.

    CRITICAL FIX: Use circular integer distance (0 to ring_n/2) instead of radians.
    This ensures σ values are in neuron units, not radian units.

    At d=0:  W = A_exc - A_inh = +0.60 (strong self-excitation)
    At d=4-5: W < 0 (inhibitory surround)
    At d=32: W ≈ 0 (far field)
    """
    rows = []
    for i in range(ring_n):
        d = jnp.arange(ring_n, dtype=jnp.float32)
        d = jnp.abs(d - i)
        d = jnp.minimum(d, ring_n - d)  # circular: max distance = ring_n/2 = 32
        # Gaussian in INTEGER index units (not radians!)
        w = (a_exc * jnp.exp(-d**2 / (2 * sigma_exc**2))
             - a_inh * jnp.exp(-d**2 / (2 * sigma_inh**2)))
        rows.append(w)
    W = jnp.stack(rows)

    # Normalize by self-connection (diagonal = 1.0)
    W = W / (W[0, 0] + 1e-8)
    W = W * 1.0

    return W


def build_asymmetric_ring_weights(ring_n=RING_N, sigma=RING_SIGMA_EXC):
    """Build asymmetric weight matrix for ω → bump shift.

    W_asym[i,j] = d/dn G(n_i - n_j) — odd function using INTEGER index distance.
    Positive when j is "ahead" (positive omega direction), negative when "behind".
    Returns: (ring_n, ring_n)
    """
    rows = []
    for i in range(ring_n):
        n = jnp.arange(ring_n, dtype=jnp.float32)
        diff = n - i  # signed difference in index
        # Circular: wrap to [-ring_n/2, ring_n/2]
        diff = jnp.where(diff > ring_n / 2, diff - ring_n, diff)
        diff = jnp.where(diff < -ring_n / 2, diff + ring_n, diff)
        # diff > 0 means j is "ahead" of i (positive omega direction)
        # Use DoG derivative: w_asym = diff * exp(-diff²/(2σ²))
        w_asym = diff * jnp.exp(-diff**2 / (2 * sigma**2))
        rows.append(w_asym)
    W_asym = jnp.stack(rows)
    # Normalize so max absolute value = 1
    W_asym = W_asym / (jnp.abs(W_asym).max() + 1e-8)
    return W_asym


def build_asymmetric_cann_weights_x(cann_size=CANN_SIZE, sigma=SIGMA_EXC):
    """Build asymmetric weight matrix for vx → bump shift along x-axis.

    W_asym[(y,x), (yc,xc)] = d/dx G(x-xc) · G(y-yc)
    Returns: (N, N) where N = cann_size²
    """
    N = cann_size * cann_size
    x_c = jnp.arange(cann_size, dtype=jnp.float32)
    y_c = jnp.arange(cann_size, dtype=jnp.float32)

    # 1D derivative-of-Gaussian along x (odd function → shift)
    dx = x_c[:, None] - x_c[None, :]
    dx = jnp.where(dx > cann_size/2, dx - cann_size, dx)
    dx = jnp.where(dx < -cann_size/2, dx + cann_size, dx)
    k_x = dx * jnp.exp(-dx**2 / (2 * sigma**2))  # (cann_size, cann_size)

    # Symmetric Gaussian along y
    dy = y_c[:, None] - y_c[None, :]
    dy = jnp.where(dy > cann_size/2, dy - cann_size, dy)
    dy = jnp.where(dy < -cann_size/2, dy + cann_size, dy)
    G_y = jnp.exp(-dy**2 / (2 * sigma**2))  # (cann_size, cann_size)

    rows = []
    for y in range(cann_size):
        for x in range(cann_size):
            row = []
            for yc in range(cann_size):
                for xc in range(cann_size):
                    row.append(k_x[x, xc] * G_y[y, yc])
            rows.append(jnp.stack(row))
    W_asym = jnp.stack(rows)
    # Normalize so max absolute value = 1
    W_asym = W_asym / (jnp.abs(W_asym).max() + 1e-8)
    return W_asym


def build_asymmetric_cann_weights_y(cann_size=CANN_SIZE, sigma=SIGMA_EXC):
    """Build asymmetric weight matrix for vy → bump shift along y-axis.

    W_asym[(y,x), (yc,xc)] = G(x-xc) · d/dy G(y-yc)
    Returns: (N, N) where N = cann_size²
    """
    N = cann_size * cann_size
    x_c = jnp.arange(cann_size, dtype=jnp.float32)
    y_c = jnp.arange(cann_size, dtype=jnp.float32)

    # Symmetric Gaussian along x
    dx = x_c[:, None] - x_c[None, :]
    dx = jnp.where(dx > cann_size/2, dx - cann_size, dx)
    dx = jnp.where(dx < -cann_size/2, dx + cann_size, dx)
    G_x = jnp.exp(-dx**2 / (2 * sigma**2))  # (cann_size, cann_size)

    # 1D derivative-of-Gaussian along y (odd function → shift)
    dy = y_c[:, None] - y_c[None, :]
    dy = jnp.where(dy > cann_size/2, dy - cann_size, dy)
    dy = jnp.where(dy < -cann_size/2, dy + cann_size, dy)
    k_y = dy * jnp.exp(-dy**2 / (2 * sigma**2))  # (cann_size, cann_size)

    rows = []
    for y in range(cann_size):
        for x in range(cann_size):
            row = []
            for yc in range(cann_size):
                for xc in range(cann_size):
                    row.append(G_x[x, xc] * k_y[y, yc])
            rows.append(jnp.stack(row))
    W_asym_y = jnp.stack(rows)
    # Normalize so max absolute value = 1
    W_asym_y = W_asym_y / (jnp.abs(W_asym_y).max() + 1e-8)
    return W_asym_y


# ============================================================================
# 2. Neural Field Dynamics
# ============================================================================

def neural_field_update(u, r, W, I_ext, dt=DT, tau=0.05):
    """Discrete neural field: τ·du/dt = -u + W@r + I_ext

    r: (B, N), W: (N, N), I_ext: (B, N)
    W @ r for each sample in batch: einsum('ij,bj->bi', W, r)
    """
    decay = 1.0 - dt / tau
    drive = (jnp.einsum('ij,bj->bi', W, r) + I_ext) * (dt / tau)
    return decay * u + drive


def lif_step(v, beta=BETA_LIF, v_th=V_TH):
    """LIF: v_new = β·v + (1-β)·v_in; spike = relu(v_new - v_th); reset by subtraction"""
    v_new = beta * v + (1 - beta) * v_th
    spike = jnp.clip(v_new - v_th, 0.0, 1.0)
    v_new = v_new - spike * v_th
    return v_new, spike


# ============================================================================
# 3. State Readout from Attractors
# ============================================================================

def cann_readout(state, cann_size=CANN_SIZE):
    """Read (x, y) from CANN using circular statistics.
    state: (B, cann_size, cann_size)"""
    # Map grid indices to angles
    angles = jnp.arange(cann_size, dtype=jnp.float32) * (2 * jnp.pi / cann_size)
    sin_a = jnp.sin(angles)
    cos_a = jnp.cos(angles)

    # Normalize state
    p = state / (state.sum(axis=(1, 2), keepdims=True) + 1e-8)

    # Marginalize to 1D arrays
    p_x = p.sum(axis=1)  # (B, N)
    p_y = p.sum(axis=2)  # (B, N)

    # Circular mean for X
    cx_angle = jnp.arctan2((p_x * sin_a).sum(axis=1), (p_x * cos_a).sum(axis=1)) % (2 * jnp.pi)
    cx = cx_angle * (cann_size / (2 * jnp.pi))

    # Circular mean for Y
    cy_angle = jnp.arctan2((p_y * sin_a).sum(axis=1), (p_y * cos_a).sum(axis=1)) % (2 * jnp.pi)
    cy = cy_angle * (cann_size / (2 * jnp.pi))

    # Convert to world coordinates
    mpc = ROOM_W / cann_size
    center = cann_size / 2
    x = (cx - center) * mpc + ROOM_W / 2
    y = (cy - center) * mpc + ROOM_H / 2
    return jnp.stack([x, y], axis=1)


def ring_readout(state, ring_n=RING_N):
    """Read θ from ring using CIRCULAR statistics (arctan2 of sin/cos weighted sum).
    This correctly handles the 0°/360° boundary unlike linear mean.
    state: (B, ring_n)"""
    angles = jnp.arange(ring_n, dtype=jnp.float32) * (2 * jnp.pi / ring_n)
    p = state / (state.sum(axis=1, keepdims=True) + 1e-8)
    # Circular mean: arctan2(sum(sin*weight), sum(cos*weight))
    sin_sum = (jnp.sin(angles) * p).sum(axis=1)
    cos_sum = (jnp.cos(angles) * p).sum(axis=1)
    theta = jnp.arctan2(sin_sum, cos_sum) % (2 * jnp.pi)
    return theta


# ============================================================================
# 4. Sensory Correction — Landmark Injection
# ============================================================================

def sensory_correction_xy(pose_est, obs_world, cann_size=CANN_SIZE, sigma=SIGMA_EXC * 1.5):
    """Gaussian bump at observed obstacle position in CANN cell space.

    pose_est: (B, 3) — [x, y, θ]
    obs_world: (B, 2) — observed obstacle [ox, oy] in world meters
    Returns: (B, cann_size, cann_size)
    """
    ox, oy = obs_world[:, 0], obs_world[:, 1]
    mpc = ROOM_W / cann_size
    cx_cell = ox / mpc + cann_size / 2
    cy_cell = oy / mpc + cann_size / 2

    xx, yy = jnp.meshgrid(
        jnp.arange(cann_size, dtype=jnp.float32),
        jnp.arange(cann_size, dtype=jnp.float32),
        indexing='xy'
    )

    def _bump(cx, cy):
        d2 = (xx - cx)**2 + (yy - cy)**2
        bump = jnp.exp(-d2 / (2 * sigma**2))
        return bump / (bump.sum() + 1e-8)

    corr = jax.vmap(_bump)(cx_cell, cy_cell)
    return corr * SENS_GAIN_XY


def sensory_correction_theta(pose_est, bearing_obs, ring_n=RING_N, sigma=RING_SIGMA_EXC * 1.5):
    """Gaussian bump at world bearing on ring.

    pose_est: (B, 3)
    bearing_obs: (B,) — relative bearing
    Returns: (B, ring_n)
    """
    world_bearing = (pose_est[:, 2] + bearing_obs) % (2 * jnp.pi)
    angles = jnp.arange(ring_n, dtype=jnp.float32) * (2 * jnp.pi / ring_n)
    sigma_rad = sigma / ring_n * 2 * jnp.pi

    def _bump(wb):
        d = jnp.abs(angles - wb)
        d = jnp.minimum(d, 2 * jnp.pi - d)
        bump = jnp.exp(-d**2 / (2 * sigma_rad**2))
        return bump / (bump.sum() + 1e-8)

    corr = jax.vmap(_bump)(world_bearing)
    return corr * SENS_GAIN_TH


# ============================================================================
# 5. Perception: Bearing + Obstacle Projection
# ============================================================================

def events_to_bearing(ev_frame):
    """Weighted mean angle of ON events in the CENTER REGION only (stable heading cue).
    
    Only uses pixels within ±30% of FOV center — discards peripheral noise events.
    ev_frame: (N_PIXELS,)
    """
    pixels = jnp.arange(N_PIXELS, dtype=jnp.float32)
    half_fov = jnp.radians(FOV_DEG) / 2
    angles = -half_fov + (2 * half_fov) * pixels / (N_PIXELS - 1)
    
    # Center mask: only use central ±30% of FOV
    center_half_width = 0.30 * half_fov  # ±30% of FOV = ±27° for 180° FOV
    mask = (angles >= -center_half_width) & (angles <= center_half_width)
    ev_center = ev_frame * mask.astype(jnp.float32)
    
    s = ev_center.sum()
    safe_s = jnp.where(s != 0, s, 1.0)
    return (ev_center * angles).sum() / safe_s


def project_obstacle(pose, bearing, tof_dist):
    """World-frame obstacle coords. pose: (B, 3), bearing: (B,), tof_dist: (B,)"""
    x, y, theta = pose[:, 0], pose[:, 1], pose[:, 2]
    w_angle = theta + bearing
    ox = x + tof_dist * jnp.cos(w_angle)
    oy = y + tof_dist * jnp.sin(w_angle)
    return jnp.stack([ox, oy], axis=1)


# ============================================================================
# 6. SNN SLAM Network
# ============================================================================

class SNNSLAM:
    """Analytically initialized CANN (2D) + Spiking Ring Attractor (1D heading)."""

    def __init__(self, key, W_cann, W_ring, W_cann_asym_x, W_cann_asym_y, W_ring_asym):
        k1, k2 = random.split(key)

        self.W_vis = random.normal(k1, (N_VIS, HIDDEN)) * 0.06
        self.W_vis_scale = 5.0

        self.W_readout = random.normal(k2, (HIDDEN + 2 + 1, N_OUT)) * 0.04
        self.b_readout = jnp.zeros(N_OUT)

        # Attractor weights (analytical DoG)
        self.W_cann = W_cann
        self.W_ring = W_ring
        self.W_cann_asym_x = W_cann_asym_x
        self.W_cann_asym_y = W_cann_asym_y
        self.W_ring_asym = W_ring_asym

        self._v_lif = None
        self._u_cann = None
        self._r_cann = None
        self._u_ring = None
        self._r_ring = None

    def reset(self, B):
        self._v_lif = jnp.zeros((B, HIDDEN))

        # CANN: Gaussian bump at room center (fallback initialization)
        xx, yy = jnp.meshgrid(
            jnp.arange(CANN_SIZE, dtype=jnp.float32),
            jnp.arange(CANN_SIZE, dtype=jnp.float32),
            indexing='ij'
        )
        bump = jnp.exp(-((xx - CANN_SIZE//2)**2 + (yy - CANN_SIZE//2)**2) / (2 * SIGMA_EXC**2))
        bump = bump / (bump.max() + 1e-8)
        self._u_cann = jnp.tile(0.5 * bump[None, :, :], (B, 1, 1))
        self._r_cann = jnp.clip(self._u_cann, 0, 1)

        # Ring: Gaussian bump at angle 0 using INTEGER INDEX distance
        idx = jnp.arange(RING_N, dtype=jnp.float32)
        d = jnp.abs(idx - 0.0)
        d = jnp.minimum(d, RING_N - d)  # circular distance
        bump_r = jnp.exp(-d**2 / (2 * RING_SIGMA_EXC**2))  # sigma in neuron units!
        bump_r = bump_r / (bump_r.sum() + 1e-8)
        self._u_ring = jnp.tile(0.5 * bump_r[None, :], (B, 1))
        self._r_ring = jnp.clip(self._u_ring, 0, 1.0)

    def initialize_from_gt(self, gt_pos, gt_heading):
        """Initialize CANN and Ring at GT pose for proper trajectory tracking.
        gt_pos: (B, 2) in world meters [x, y]
        gt_heading: (B,) in radians [-π, π]
        Sets voltage at bump center to threshold so bumps spawn at correct positions.
        """
        B = gt_pos.shape[0]

        # ---- CANN: Set bump at GT (x, y) using vectorized ops ----
        mpc = float(ROOM_W) / CANN_SIZE  # meters per cell
        # Convert world coords to cell indices
        cx_float = (gt_pos[:, 0] - ROOM_W / 2) / mpc + CANN_SIZE / 2
        cy_float = (gt_pos[:, 1] - ROOM_H / 2) / mpc + CANN_SIZE / 2

        xx, yy = jnp.meshgrid(
            jnp.arange(CANN_SIZE, dtype=jnp.float32),
            jnp.arange(CANN_SIZE, dtype=jnp.float32),
            indexing='xy'
        )

        # For each batch, create bump centered at (cx_float[b], cy_float[b])
        # Vectorized: compute all bumps at once using broadcasting
        cx_exp = cx_float[:, None, None]  # (B, 1, 1)
        cy_exp = cy_float[:, None, None]  # (B, 1, 1)
        d2 = (xx[None, :, :] - cx_exp)**2 + (yy[None, :, :] - cy_exp)**2
        bumps = jnp.exp(-d2 / (2 * SIGMA_EXC**2))
        bumps = bumps / (bumps.max(axis=(1, 2), keepdims=True) + 1e-8)  # normalize by max for strong peak
        self._u_cann = jnp.clip(bumps, 0, 1.0)
        self._r_cann = self._u_cann

        # ---- Ring: Set bump at GT heading using vectorized ops ----
        # Convert heading to ring index [0, RING_N)
        th_idx_float = (gt_heading % (2 * jnp.pi)) * (RING_N / (2 * jnp.pi))

        idx = jnp.arange(RING_N, dtype=jnp.float32)[None, :]  # (1, RING_N)
        th_exp = th_idx_float[:, None]  # (B, 1)
        d = jnp.abs(idx - th_exp)  # (B, RING_N)
        d = jnp.minimum(d, RING_N - d)  # circular wrap
        bumps_r = jnp.exp(-d**2 / (2 * RING_SIGMA_EXC**2))
        bumps_r = bumps_r / (bumps_r.max(axis=1, keepdims=True) + 1e-8)  # normalize by max for strong peak
        self._u_ring = jnp.clip(bumps_r, 0, 1.0)
        self._r_ring = self._u_ring

    def __call__(self, ev_t, kin_t, tof_t, obs_corr=None, bear_corr=None, pose_est=None):
        B = ev_t.shape[0]

        # Visual
        ev_pol = jnp.concatenate([jnp.clip(ev_t, 0, 1), jnp.clip(-ev_t, 0, 1)], axis=1)
        i_vis = ev_pol @ (self.W_vis * self.W_vis_scale)

        # LIF
        self._v_lif, spike = lif_step(self._v_lif)

        # Kinematics
        vx, vy, omega = kin_t[:, 0], kin_t[:, 1], kin_t[:, 2]

        # ---- CANN: Body-frame to Global-frame rotation ----
        # IMU velocity (vx, vy) is in body frame relative to robot heading
        # Rotate to global/map frame using current decoded heading from ring
        theta = ring_readout(self._r_ring)  # (B,) current heading in radians
        cos_t = jnp.cos(theta)
        sin_t = jnp.sin(theta)

        # Rotate body-frame velocity to global frame
        # v_map_x = vx*cos(θ) - vy*sin(θ)
        # v_map_y = vx*sin(θ) + vy*cos(θ)
        V_map_x = vx * cos_t - vy * sin_t  # global x velocity
        V_map_y = vx * sin_t + vy * cos_t  # global y velocity

        # ---- CANN: Asymmetric weight current injection (organic SNN physics) ----
        # FIXED: einsum 'ij,bj->bi' (not 'nm,bn->bm') sums over source neurons
        r_flat = self._r_cann.reshape(B, -1)  # (B, 1024)
        I_vel_x = VEL_GAIN_XY * jnp.einsum('ij,bj->bi', self.W_cann_asym_x, r_flat) * V_map_x[:, None]
        I_vel_y = VEL_GAIN_XY * jnp.einsum('ij,bj->bi', self.W_cann_asym_y, r_flat) * V_map_y[:, None]

        # Sensory correction (disabled for now - was destabilizing)
        I_sens_flat = jnp.zeros((B, CANN_SIZE * CANN_SIZE))

        # Neural field update with velocity-driven shift
        u_flat = self._u_cann.reshape(B, -1)
        u_new = neural_field_update(u_flat, r_flat + 1e-8, self.W_cann,
                                    I_vel_x + I_vel_y + I_sens_flat,
                                    dt=DT, tau=TAU_U)
        self._u_cann = u_new.reshape(B, CANN_SIZE, CANN_SIZE)
        self._r_cann = jnp.clip(self._u_cann, 0, 1.0)

        # ---- Ring ----
        # Negative gain: diff=n-i pushes opposite to desired direction
        I_vel_raw = -VEL_GAIN_TH * omega[:, None] * jnp.einsum('ij,bj->bi', self.W_ring_asym, self._r_ring)
        # Wrap-safe smoothing: circular average with neighbors to blur seam at 0/63 boundary
        I_vel_smooth = (jnp.roll(I_vel_raw, 1, axis=1) + I_vel_raw + jnp.roll(I_vel_raw, -1, axis=1)) / 3.0
        I_sens_ring = jnp.zeros((B, RING_N))  # disabled for testing

        u_ring_new = neural_field_update(self._u_ring, self._r_ring + 1e-8,
                                        self.W_ring,
                                        I_vel_smooth + I_sens_ring,
                                        dt=DT, tau=RING_TAU_U)
        # Pure activation: let u find natural equilibrium, clamp firing rate
        self._u_ring = jnp.maximum(0.0, u_ring_new)
        self._r_ring = jnp.clip(self._u_ring, 0, 1.0)

        # ---- Readout ----
        pos = cann_readout(self._r_cann)  # (B, 2) in meters
        th = ring_readout(self._r_ring)[:, None]  # (B, 1) in radians

        x_out = pos[:, 0]
        y_out = pos[:, 1]
        th_out = th[:, 0]

        return jnp.stack([x_out, y_out, th_out, jnp.zeros(B), jnp.zeros(B)], axis=1)


# ============================================================================
# 7. Evaluation
# ============================================================================

def evaluate_slam(net, key, n_samples=32):
    """Run SLAM with sensory correction at each step."""

    events, labels, tof_dists, positions, obstacles, _ = \
        generate_fixed_room_dataset(key, n_samples)

    # Compute initial heading from positions (h0 isn't stored directly)
    # h0 = world-frame direction of initial velocity
    # Use first few timesteps to reduce noise
    dt_heading = 3
    dx = positions[:, dt_heading, 0] - positions[:, 0, 0]
    dy = positions[:, dt_heading, 1] - positions[:, 0, 1]
    world_movement_angle = jnp.arctan2(dy, dx)

    vx_true = labels[:, 0] * np.abs(VX_RANGE[1])
    vy_true = labels[:, 1] * np.abs(VY_RANGE[1])
    local_velocity_angle = jnp.arctan2(vy_true, vx_true)
    
    headings_gt = (world_movement_angle - local_velocity_angle) % (2 * np.pi) # (B,) initial heading per sample

    ev = np.array(events)
    tof = np.array(tof_dists)
    pos_gt = np.array(positions[:, :, :2])
    T = TIME_STEPS

    kin = np.stack([
        np.tile(labels[:, 0:1] * np.abs(VX_RANGE[1]), (1, T)),
        np.tile(labels[:, 1:2] * np.abs(VY_RANGE[1]), (1, T)),
        np.tile(labels[:, 2:3] * np.abs(OMEGA_RANGE[1]), (1, T)),
    ], axis=2)

    net.reset(n_samples)

    # Initialize CANN and Ring at GT pose (user's fix)
    net.initialize_from_gt(jnp.array(pos_gt[:, 0]), headings_gt)  # headings_gt is (B,)

    x_e = np.zeros((n_samples, T))
    y_e = np.zeros((n_samples, T))
    th_e = np.zeros((n_samples, T))

    # Track CANN and heading positions over time (diagnostic)
    cann_x = np.zeros((n_samples, T))
    cann_y = np.zeros((n_samples, T))
    th_est = np.zeros((n_samples, T))

    for t in range(T):
        ev_t = ev[:, t, :]
        kin_t = kin[:, t, :]
        tof_t = tof[:, t]

        bear = np.array(jax.vmap(events_to_bearing)(ev_t))
        tof_m = tof_t * 8.0

        pose = np.stack([
            np.array(cann_readout(net._r_cann)[:, 0]),
            np.array(cann_readout(net._r_cann)[:, 1]),
            np.array(ring_readout(net._r_ring)),
        ], axis=1)

        # Track bump centers BEFORE update
        cann_x[:, t] = pose[:, 0]
        cann_y[:, t] = pose[:, 1]
        th_est[:, t] = pose[:, 2]

        # Ring peak neuron tracking (for multi-wrap detection)
        r_ring_np = np.array(net._r_ring)
        peak_n = np.argmax(r_ring_np, axis=1)

        if t < 5:
            print(f'    t={t}: bear={np.degrees(bear[0]):.1f}°, pose_theta={np.degrees(pose[0,2]):.1f}°, omega={kin_t[0,2]:.3f}, ring_peak={peak_n[0]}')

        obs_w = np.array(project_obstacle(
            jnp.array(pose), jnp.array(bear), jnp.array(tof_m)))

        out = net(ev_t, kin_t, tof_t,
                 obs_corr=jnp.array(obs_w),
                 bear_corr=jnp.array(bear))

        x_e[:, t] = np.array(out[:, 0])
        y_e[:, t] = np.array(out[:, 1])
        th_e[:, t] = np.array(out[:, 2])

    # Compute GT heading BEFORE diagnostic (needed there too)
    omega_signed = np.array(labels[:, 2:3]) * OMEGA_RANGE[1]  # signed omega
    th_gt = np.cumsum(np.tile(omega_signed, (1, T)) * DT, axis=1)
    th_gt = np.concatenate([np.zeros((n_samples, 1)), th_gt[:, :-1]], axis=1)
    # Add initial heading offset and wrap to [0, 2π)
    th_gt = (th_gt + headings_gt[:, None]) % (2 * np.pi)

    # Per-sample omega analysis
    # Position diagnostic
    print(f"\n  🦊 CANN Position Diagnostic (sample 0):")
    dx_e = np.diff(x_e[0])
    dy_e = np.diff(y_e[0])
    dist_per_step = np.sqrt(dx_e**2 + dy_e**2)
    total_disp = np.sqrt((x_e[0, -1]-x_e[0, 0])**2 + (y_e[0, -1]-y_e[0, 0])**2)
    gt_disp = np.sqrt((pos_gt[0, -1, 0]-pos_gt[0, 0, 0])**2 + (pos_gt[0, -1, 1]-pos_gt[0, 0, 1])**2)
    init_offset = np.sqrt((x_e[0,0]-pos_gt[0,0,0])**2 + (y_e[0,0]-pos_gt[0,0,1])**2)
    print(f"    GT total displacement: {gt_disp:.3f} m")
    print(f"    CANN total displacement: {total_disp:.3f} m")
    print(f"    Ratio (CANN/GT): {total_disp/(gt_disp+1e-9):.2f}")
    print(f"    CANN initial offset from GT: {init_offset:.3f} m")
    print(f"    Mean step dist (CANN): {dist_per_step.mean()*100:.2f} cm  |  GT: {np.sqrt(np.diff(pos_gt[0,:,0])**2 + np.diff(pos_gt[0,:,1])**2).mean()*100:.2f} cm")

    # Ring heading diagnostic
    print(f"\n  🦊 Ring Heading Diagnostic (sample 0):")
    gt_rot = np.degrees(th_gt[0, -1] - th_gt[0, 0])
    est_rot = np.degrees(th_est[0, -1] - th_est[0, 0])
    print(f"    GT total heading change: {gt_rot:.1f}°")
    print(f"    Ring total heading change: {est_rot:.1f}°")
    print(f"    Heading error: {abs(gt_rot - est_rot):.1f}°")
    print(f"    Ring th[0]: {np.degrees(th_est[0,0]):.1f}°  th[1]: {np.degrees(th_est[0,1]):.1f}°  th[2]: {np.degrees(th_est[0,2]):.1f}°")

    pos_err = np.sqrt((x_e - pos_gt[:, :, 0])**2 + (y_e - pos_gt[:, :, 1])**2)
    th_err = np.abs(th_e - th_gt)
    th_err = np.minimum(th_err, 2 * np.pi - th_err)

    print(f"\n📊 SLAM Evaluation ({n_samples} trajectories):")
    print(f"  Mean position error: {pos_err.mean():.3f} m")
    print(f"  Final position error: {pos_err[:, -1].mean():.3f} m")
    print(f"  Mean angular error: {np.degrees(th_err.mean()):.1f}°")

    return {
        'x_est': x_e, 'y_est': y_e, 'theta_est': th_e,
        'x_gt': pos_gt[:, :, 0], 'y_gt': pos_gt[:, :, 1],
        'theta_gt': th_gt,
        'pos_error': pos_err, 'theta_error': th_err,
        'obstacles': np.array(obstacles),
        'events': np.array(events),
        'tof': np.array(tof_dists),
        'labels': np.array(labels),
        'cann_x': cann_x, 'cann_y': cann_y, 'theta_est': th_est,
    }


# ============================================================================
# 8. Visualization
# ============================================================================

def plot_attractor_weights(W_cann, W_ring, W_ring_asym):
    """Visualize the DoG weight matrices."""
    W_cann = np.array(W_cann)
    W_ring = np.array(W_ring)
    W_ring_asym = np.array(W_ring_asym)

    fig, axes = plt.subplots(1, 3, figsize=(16, 5))

    # 2D CANN: Weight profile from center source neuron
    # W_cann shape: (1024, 1024) = (N_dest, N_src), dest/src = ry*32+rx
    # Column at src_idx = weights TO src from all dests
    # Row at src_idx = weights FROM src to all dests
    # For a translation-invariant CANN, row == column (symmetric DoG)
    # ===============================================================
    ax = axes[0]
    src_idx = (CANN_SIZE // 2) * CANN_SIZE + (CANN_SIZE // 2)  # center neuron
    # Direct extraction: W[dest_idx, src_idx] for 2D profile
    profile = np.zeros((CANN_SIZE, CANN_SIZE), dtype=np.float32)
    for dest_ry in range(CANN_SIZE):
        for dest_rx in range(CANN_SIZE):
            dest_idx = dest_ry * CANN_SIZE + dest_rx
            profile[dest_ry, dest_rx] = W_cann[dest_idx, src_idx]
    im = ax.imshow(profile, cmap='RdBu_r', vmin=-0.4, vmax=0.4, aspect='equal')
    ax.set_title('2D CANN: DoG Weight Profile\n(weight from center neuron to all others)')
    ax.set_xlabel('Neuron x')
    ax.set_ylabel('Neuron y')
    ax.plot([CANN_SIZE//2], [CANN_SIZE//2], 'w*', markersize=12, label='source')
    ax.legend(loc='upper right', fontsize=8)
    plt.colorbar(im, ax=ax, fraction=0.046)

    # Ring: full matrix — symmetric colormap on ACTUAL data range
    W_ring_np = np.array(W_ring)
    vmax_ring = max(abs(W_ring_np.min()), abs(W_ring_np.max()))
    ax = axes[1]
    im2 = ax.imshow(W_ring_np, cmap='RdBu_r', vmin=-vmax_ring, vmax=vmax_ring, aspect='equal')
    ax.set_title('1D Ring Attractor: Full W matrix\n(periodic DoG)')
    ax.set_xlabel('Neuron j')
    ax.set_ylabel('Neuron i')
    plt.colorbar(im2, ax=ax, fraction=0.046)

    # Ring: asymmetric (shift) — symmetric colormap on ACTUAL data range
    W_ring_asym_np = np.array(W_ring_asym)
    vmax_asym = max(abs(W_ring_asym_np.min()), abs(W_ring_asym_np.max()))
    ax = axes[2]
    im3 = ax.imshow(W_ring_asym_np, cmap='RdBu_r', vmin=-vmax_asym, vmax=vmax_asym, aspect='equal')
    ax.set_title('1D Ring: Asymmetric W (ω → shift)\n(+ left, - right = direction)')
    ax.set_xlabel('Neuron j')
    ax.set_ylabel('Neuron i')
    plt.colorbar(im3, ax=ax, fraction=0.046)

    fig.suptitle('Analytically Initialized Attractor Weights\n'
                  'Mexican Hat / Difference-of-Gaussians (DoG)',
                  fontsize=12, fontweight='bold')
    plt.tight_layout()
    out = '/Users/lhooz/.openclaw/workspace/results/slam_attractor_weights.png'
    fig.savefig(out, dpi=120, bbox_inches='tight', facecolor='white')
    print(f'📸 Saved: {out}')
    plt.close(fig)
    return out


def visualize_slam(results, n_show=N_SHOW):
    """3-panel SLAM visualization."""
    x_e = results['x_est'][:n_show]
    y_e = results['y_est'][:n_show]
    th_e = results['theta_est'][:n_show]
    x_g = results['x_gt'][:n_show]
    y_g = results['y_gt'][:n_show]
    obs = results['obstacles']
    ev = results['events'][:n_show]
    tof = results['tof'][:n_show]

    fig, axes = plt.subplots(1, 3, figsize=(20, 6.5))
    colors = plt.cm.tab10(np.linspace(0, 1, n_show))
    t_s = np.arange(TIME_STEPS) * DT
    stp = max(1, TIME_STEPS // 20)

    # Panel 1: Trajectory GT vs. Est
    ax = axes[0]
    ax.set_xlim(-0.5, ROOM_W + 0.5)
    ax.set_ylim(-0.5, ROOM_H + 0.5)
    ax.set_aspect('equal')
    ax.set_xlabel('x (m)', fontsize=10)
    ax.set_ylabel('y (m)', fontsize=10)
    ax.set_title('SLAM: Trajectory Estimation\nGround Truth vs. Neural Estimate',
                 fontsize=11, fontweight='bold')
    ax.grid(alpha=0.25, linestyle='--')
    ax.add_patch(Rectangle((0, 0), ROOM_W, ROOM_H, lw=2.5, edgecolor='#333',
                          facecolor='#f5f5f0', alpha=0.4))
    for o in obs:
        w, h = float(o[2]-o[0]), float(o[3]-o[1])
        ax.add_patch(Rectangle((float(o[0]), float(o[1])), w, h,
                              facecolor='#666', edgecolor='#222', lw=1.2, alpha=0.85))
    for idx in range(n_show):
        ax.plot(x_g[idx, ::stp], y_g[idx, ::stp], '-', color=colors[idx],
                alpha=0.9, lw=2.5, label='GT' if idx == 0 else None)
        ax.plot(x_e[idx, ::stp], y_e[idx, ::stp], '--', color=colors[idx],
                alpha=0.7, lw=2.0, label='Est' if idx == 0 else None)
        ax.add_patch(Circle((float(x_g[idx, 0]), float(y_g[idx, 0])),
                          0.12, color=colors[idx], alpha=0.9, zorder=10))
        ax.add_patch(Circle((float(x_g[idx, -1]), float(y_g[idx, -1])),
                          0.10, color='#2ecc71', alpha=0.9, zorder=10))
    ax.legend(loc='upper right', fontsize=8)

    # Panel 2: Event Camera + ToF
    ax = axes[1]
    ax.set_xlabel('Timestep', fontsize=10)
    ax.set_ylabel('Pixel (1D, 64px, 180° FOV)', fontsize=10)
    ax.set_title('Event Camera + ToF Readings', fontsize=11, fontweight='bold')
    ax.set_xlim(0, TIME_STEPS)
    ax.set_ylim(0, N_PIXELS)
    ax.grid(alpha=0.2, linestyle=':')
    for idx in range(n_show):
        e = ev[idx]
        t_on, p_on = np.where(e > 0)
        t_off, p_off = np.where(e < 0)
        ax.scatter(t_on, p_on, c=[colors[idx]], s=10, marker='o', alpha=0.5)
        ax.scatter(t_off, p_off, c=[colors[idx]], s=10, marker='o',
                   facecolors='none', edgecolors=colors[idx], alpha=0.3, lw=0.8)
    ax2 = ax.twinx()
    for idx in range(n_show):
        ax2.plot(np.arange(TIME_STEPS), tof[idx] * 8.0, '-', color=colors[idx], alpha=0.5, lw=1.5)
    ax2.set_ylabel('ToF Distance (m)', fontsize=9, color='gray')
    ax2.set_ylim(0, 8.5)
    ax2.tick_params(axis='y', labelcolor='gray', labelsize=8)

    # Panel 3: Occupancy Grid
    ax = axes[2]
    ax.set_xlim(-0.5, ROOM_W + 0.5)
    ax.set_ylim(-0.5, ROOM_H + 0.5)
    ax.set_aspect('equal')
    ax.set_xlabel('x (m)', fontsize=10)
    ax.set_ylabel('y (m)', fontsize=10)
    ax.set_title('Live Occupancy Grid Map\n(SLAM Twin — Neural Estimate)',
                 fontsize=11, fontweight='bold')
    ax.grid(alpha=0.25, linestyle='--', color='gray')
    ax.add_patch(Rectangle((0, 0), ROOM_W, ROOM_H, lw=2, edgecolor='#333',
                          facecolor='#f0f0f0', alpha=0.4))
    for idx in range(n_show):
        ax.plot(x_e[idx, ::stp], y_e[idx, ::stp], '-', color=colors[idx],
                alpha=0.6, lw=1.8)
        x_f, y_f, th_f = x_e[idx, -1], y_e[idx, -1], th_e[idx, -1]
        ax.arrow(x_f, y_f, 0.3 * np.cos(th_f), 0.3 * np.sin(th_f),
                head_width=0.15, head_length=0.1, color=colors[idx], alpha=0.8, zorder=10)
    for o in obs:
        w, h = float(o[2]-o[0]), float(o[3]-o[1])
        ax.add_patch(Rectangle((float(o[0]), float(o[1])), w, h,
                              facecolor='#888', edgecolor='#444', lw=1.2,
                              alpha=0.5, linestyle='--'))

    fig.suptitle(
        f'SNN Digital Twin — Neuromorphic SLAM\n'
        f'2D CANN (DoG) + 1D Ring Attractor (DoG) | Room: {ROOM_W}m × {ROOM_H}m',
        fontsize=12, fontweight='bold', y=1.01
    )
    plt.tight_layout()
    out_path = '/Users/lhooz/.openclaw/workspace/results/slam_twin_viz.png'
    fig.savefig(out_path, dpi=150, bbox_inches='tight', facecolor='white')
    print(f'📸 Saved: {out_path}')
    plt.close(fig)
    return out_path


# ============================================================================
# Main
# ============================================================================

def plot_row_sum_diagnostic(W_cann, cann_size=CANN_SIZE):
    """Show that row-sums are non-negative after area balancing."""
    W_np = np.array(W_cann)
    # Row-sums (all identical by translation invariance)
    row_sum = W_np[0, :]  # row 0
    center_idx = cann_size * cann_size // 2 + cann_size // 2

    fig, axes = plt.subplots(1, 2, figsize=(12, 4))

    ax = axes[0]
    ax.plot(row_sum, color='#2196F3', lw=2)
    ax.axhline(0, color='red', lw=1.5, linestyle='--', label='zero line')
    ax.set_xlabel('Neuron index (flattened row)')
    ax.set_ylabel('Row sum')
    ax.set_title('2D CANN Row-Sum Profile\n(should stay ≥ 0 after area balance)')
    ax.legend()
    ax.grid(alpha=0.3)

    ax = axes[1]
    profile = np.zeros((cann_size, cann_size), dtype=np.float32)
    for dest_ry in range(cann_size):
        for dest_rx in range(cann_size):
            dest_idx = dest_ry * cann_size + dest_rx
            profile[dest_ry, dest_rx] = W_np[dest_idx, center_idx]
    im = ax.imshow(profile, cmap='RdBu_r', vmin=-0.4, vmax=0.4, aspect='equal')
    ax.set_title('DoG Weight Profile (from center)')
    plt.colorbar(im, ax=ax, fraction=0.046)
    ax.plot([cann_size//2], [cann_size//2], 'w*', markersize=12)

    fig.suptitle(
        f'Area Balance Check: A_exc·σ_exc² = {A_EXC}·{SIGMA_EXC}² = {A_EXC*SIGMA_EXC**2:.2f}  |  '
        f'A_inh·σ_inh² = {A_INH}·{SIGMA_INH}² = {A_INH*SIGMA_INH**2:.2f}',
        fontsize=11, fontweight='bold'
    )
    plt.tight_layout()
    out = '/Users/lhooz/.openclaw/workspace/results/slam_row_sum_diagnostic.png'
    fig.savefig(out, dpi=120, bbox_inches='tight', facecolor='white')
    print(f'📸 Saved: {out}')
    plt.close(fig)
    return out


if __name__ == '__main__':
    print("=" * 60)
    print("  🦊 SNN SLAM Digital Twin — DoG Attractor Initialization")
    print("=" * 60)

    t0 = time.time()

    # Build analytical weight matrices
    print("\n  Building analytical DoG weight matrices...")
    W_cann = build_2d_cann_weights()
    W_ring = build_1d_ring_weights()
    W_ring_asym = build_asymmetric_ring_weights()
    W_cann_asym_x = build_asymmetric_cann_weights_x()
    print(f"  CANN weights: {W_cann.shape}  ring: {W_ring.shape}")
    print(f"  Build time: {time.time()-t0:.1f}s")

    # Pre-flight: area balance diagnostic
    print("\n  Area balance diagnostic:")
    print(f"    A_exc·σ_exc² = {A_EXC}·{SIGMA_EXC}² = {A_EXC*SIGMA_EXC**2:.3f}")
    print(f"    A_inh·σ_inh² = {A_INH}·{SIGMA_INH}² = {A_INH*SIGMA_INH**2:.3f}")
    ratio = A_EXC*SIGMA_EXC**2 / (A_INH*SIGMA_INH**2 + 1e-9)
    print(f"    Ratio (exc/inh): {ratio:.2f}  {'✅ (bump will sustain)' if ratio > 0.5 else '⚠️  (may still die)'}")
    plot_row_sum_diagnostic(W_cann)

    # Plot weight matrices
    plot_attractor_weights(W_cann, W_ring, W_ring_asym)

    # Create network
    W_cann_asym_y = build_asymmetric_cann_weights_y()
    net = SNNSLAM(random.PRNGKey(SEED), W_cann, W_ring, W_cann_asym_x, W_cann_asym_y, W_ring_asym)
    _unused = (W_ring, W_ring_asym)  # kept for API compat, heading uses integrator now

    # Evaluate
    eval_key = random.PRNGKey(SEED + 1)
    results = evaluate_slam(net, eval_key, n_samples=32)

    # Visualize
    viz_path = visualize_slam(results, n_show=N_SHOW)
    # Save
    np.savez('/Users/lhooz/.openclaw/workspace/params/slam_twin_dog_results.npz',
             x_est=results['x_est'], y_est=results['y_est'],
             theta_est=results['theta_est'],
             x_gt=results['x_gt'], y_gt=results['y_gt'],
             theta_gt=results['theta_gt'],
             pos_error=results['pos_error'],
             theta_error=results['theta_error'])
    total_time = time.time() - t0
    print(f"\n  ✅ All done in {total_time:.1f}s")
    print(f"  Results: results/slam_twin_viz.png")
    print(f"  Weights: results/slam_attractor_weights.png")
